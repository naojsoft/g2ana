#! /usr/bin/env python
#
# anaview -- Customized Ginga viewer for the Gen2 analysis servers.
#
import sys
import os

from ginga.rv import main as g_main

from ginga.misc.Bunch import Bunch

import g2ana

try:
    import fitsview.plugins
except ImportError as e:
    # Not a declared dependency, so pip will not have caught this: fitsview
    # is deployed to the analysis hosts alongside g2ana rather than fetched.
    # Say so here, because the bare ImportError names a package nobody would
    # expect a viewer in this repository to need.
    raise SystemExit(
        "anaview cannot start: the 'fitsview' package is not importable"
        " ({}).\n"
        "\n"
        "anaview runs fitsview's ObsLog and QL_* plugins rather than copies"
        " of them, so\n"
        "it needs that package installed even though nothing in g2ana's"
        " dependencies\n"
        "names it -- fitsview is deployed to the analysis hosts alongside"
        " g2ana rather\n"
        "than resolved by pip.  See the note at the top of g2ana's"
        " pyproject.toml.\n"
        "\n"
        "Install fitsview into this environment and try again.".format(e))

def get_plugin_spec(name):
    l_name = name.lower()
    for spec in g_main.plugins:
        if spec.module.lower() == l_name:
            return spec
    return KeyError(name)

def add_plugin_spec(spec):
    g_main.plugins.append(spec)


if __name__ == "__main__":
    # Tweak the sys.path here if you are loading plugins from some
    # area outside your PYTHONPATH
    moduleHome = os.path.split(g2ana.__file__)[0]
    sys.path.insert(0, moduleHome)
    pluginHome = os.path.join(moduleHome, 'plugins')
    sys.path.insert(0, pluginHome)

    # ObsLog and the QL_* plugins come from fitsview, which is the same
    # code: this viewer and the summit's differ only in where a frame that
    # the log has never displayed is read from, and ObsLog asks its
    # `loader_plugin` setting about that.  The ANA plugin names itself
    # there, so nothing needs configuring here.
    #
    # Their directory goes on sys.path because they import each other by
    # bare module name (QL_FOCAS does `import ObsLog`), the same way
    # fitsview's own launcher arranges it.  g2ana deliberately keeps no
    # copies of them: two directories on the path, each with an ObsLog.py,
    # and which one you got would come down to insertion order.
    fitsviewPluginHome = os.path.split(fitsview.plugins.__file__)[0]
    sys.path.insert(0, fitsviewPluginHome)

    # change spec of stock Header plugin to start automatically, and don't
    # show icon in Operations plugin
    spec = get_plugin_spec('header')
    spec.start = True
    spec.optray = False

    # Add Subaru-specific plugins
    for spec in [
        Bunch(module='ANA', ptype='global', hidden=True, optray=False,
              enabled=True, start=True),

        Bunch(module='Ana_UserInput', workspace='dialogs', ptype='local',
              enabled=True, hidden=True),
        Bunch(module='Ana_Confirmation', workspace='dialogs', ptype='local',
              enabled=True, hidden=True),

        Bunch(module='QL_CHARIS', workspace='right', ptype='global',
              start=False, enabled=True, category='Subaru'),
        Bunch(module='QL_IRCS', workspace='in:toplevel', ptype='global',
              start=False, enabled=True, is_toplevel=True, category='Subaru'),
        Bunch(module='QL_MOIRCS', workspace='in:toplevel', ptype='global',
              start=False, enabled=True, is_toplevel=True, category='Subaru'),
        Bunch(module='QL_FOCAS', workspace='in:toplevel', ptype='global',
              start=False, enabled=True, is_toplevel=True, category='Subaru'),
        ]:
        add_plugin_spec(spec)

    # construct viewer builder
    viewer = g_main.ReferenceViewer(layout=g_main.default_layout)
    viewer.add_default_plugins(except_local=['TVMark', 'TVMask',
                                             'ChangeHistory'])
    #viewer.add_separately_distributed_plugins()

    # Parse command line options
    from argparse import ArgumentParser

    argprs = ArgumentParser()
    viewer.add_default_options(argprs)

    (options, args) = argprs.parse_known_args(sys.argv[1:])

    if options.display:
        os.environ['DISPLAY'] = options.display

    viewer.main(options, args)
